<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="AccentBrush" Color="#285FF0" />
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="#243044" /><Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#D8DEE8" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,8" /><Setter Property="MinHeight" Value="34" />
    <Setter Property="Cursor" Value="Hand" /><Setter Property="FontSize" Value="13" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#285FF0" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="#285FF0" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#285FF0" />
  </Style>
  <Style x:Key="GroupButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="7,2" /><Setter Property="MinHeight" Value="26" />
  </Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6" /><Setter Property="MinHeight" Value="32" /><Setter Property="BorderBrush" Value="#D8DEE8" /><Setter Property="Background" Value="White" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,5" /><Setter Property="MinHeight" Value="32" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style TargetType="DataGrid"><Setter Property="RowHeight" Value="40" /><Setter Property="ColumnHeaderHeight" Value="36" /><Setter Property="BorderBrush" Value="#DFE4EC" /><Setter Property="GridLinesVisibility" Value="Horizontal" /><Setter Property="HorizontalGridLinesBrush" Value="#EEF1F5" /><Setter Property="Background" Value="White" /><Setter Property="RowBackground" Value="White" /><Setter Property="AlternatingRowBackground" Value="#FAFBFD" /><Setter Property="HeadersVisibility" Value="Column" /></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F2F4F8" /><Setter Property="Foreground" Value="#596579" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Padding" Value="10,6" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,3" /><Setter Property="BorderThickness" Value="0" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="18,10" /><Setter Property="FontSize" Value="14" /></Style>
</ResourceDictionary>
